# ── Content API ───────────────────────────────────────────────────────────
# Base URL of the Diamond Advocates admin API that serves this site's content
# (the diamond_advocates_admin_api deployment).
#
# Optional. Left unset the site still builds and renders correctly, using the
# content in lib/fallback.ts — useful for a bare checkout or a preview branch
# that should not touch the live CMS.
NEXT_PUBLIC_CONTENT_API_URL=http://localhost:3001

# ── Shared secrets (must match the admin repo exactly) ────────────────────
# Authenticates the publish webhook the admin POSTs to /api/revalidate here,
# which drops this site's cache for the published section.
REVALIDATE_SECRET=another-long-random-string-shared-with-the-admin-repo

# Verifies the signed preview links the admin hands to editors, and
# authenticates this site's server-side reads of unpublished draft content.
# Without it, /api/preview returns 501 and previewing is unavailable.
PREVIEW_SECRET=a-third-long-random-string-shared-with-the-admin-repo

# ── Media (optional) ──────────────────────────────────────────────────────
# Custom domain serving images uploaded through the admin panel, if one is set
# up — it must match R2_PUBLIC_URL in the admin repo. Uploads served straight
# from the bucket's own *.r2.dev URL need no configuration.
MEDIA_PUBLIC_URL=https://media.diamondadvocates.com

RESEND_API_KEY=your_resend_api_key_here